# Set these in your shell/host. .env files are not loaded automatically.
# Native local PostgreSQL setup uses the current OS username without a password.
DATABASE_URL=postgresql://127.0.0.1:55432/stash
TEST_DATABASE_URL=postgresql://127.0.0.1:55432/stash_test
WEB_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:4000
API_URL=http://127.0.0.1:4000
PORT=4000
# Without SMTP, messages are captured privately on disk and never sent.
MAIL_DIR=../../.data/mail
# Production requires HTTPS origins, DATABASE_URL, and durable deletion storage.
# Set EMAIL_DISABLED=true to disable verification/recovery until SMTP is available.
# Otherwise production requires MAIL_FROM and either RESEND_API_KEY or SMTP_URL.
# RESEND_API_KEY=your-private-resend-api-key
# MAIL_FROM=Stash <noreply@your-verified-domain.example>
# EMAIL_DISABLED=true
# SMTP_URL=smtps://username:password@smtp.your-business.example:465
# MAIL_FROM=Stash <hello@your-business.example>
# Docker alternative credentials are for local development only:
# DATABASE_URL=postgresql://stash:stash_local_only@127.0.0.1:55432/stash
# Production deletion intents must survive database restore and redeployment:
# DELETION_JOURNAL_DIR=/persistent/stash-deletions

# Separate admin client. Admin API is disabled unless a private key is configured.
ADMIN_WEB_ORIGIN=http://127.0.0.1:3001
# Generate once with: node -e 'process.stdout.write(require("node:crypto").randomBytes(32).toString("base64"))'
# ADMIN_ENCRYPTION_KEY=private-canonical-base64-32-byte-key
# Preserve this key securely across redeploys and restores. Never commit it.

# Library v2 rollout. New kinds remain disabled in production until coordinated release.
# LIBRARY_V2_ENABLED=true
# Private PDF storage. All five B2 values are required together.
# Development uses a private FILE_DIR when B2 is not configured.
# B2_ENDPOINT=https://s3.your-region.backblazeb2.com
# B2_REGION=your-region
# B2_BUCKET=your-private-bucket
# B2_KEY_ID=private-key-id
# B2_APPLICATION_KEY=private-application-key
# FILE_DIR=../../.data/files

# Optional on-demand summaries. Free-only routing; paid models are rejected.
# OPENROUTER_API_KEY=private-openrouter-key
# OPENROUTER_MODEL=cohere/north-mini-code:free
# SUMMARIES_ENABLED=false
# Fixed safeguards: 5 requests/account/UTC day, 300,000 reserved tokens/account/day,
# 100 requests globally/day, 1,000 globally/month, $0 monthly spending.
