# Set these in your shell/host. .env files are not loaded automatically.
# Native local PostgreSQL setup uses the current OS username without a password.
DATABASE_URL=postgresql://127.0.0.1:55432/stash
TEST_DATABASE_URL=postgresql://127.0.0.1:55432/stash_test
WEB_ORIGIN=http://127.0.0.1:3000
PUBLIC_API_URL=http://127.0.0.1:4000
API_URL=http://127.0.0.1:4000
PORT=4000
# Without SMTP, messages are captured privately on disk and never sent.
MAIL_DIR=../../.data/mail
# Production requires HTTPS origins, DATABASE_URL, SMTP_URL, and MAIL_FROM.
# SMTP_URL=smtps://username:password@smtp.your-business.example:465
# MAIL_FROM=Stash <hello@your-business.example>
# Docker alternative credentials are for local development only:
# DATABASE_URL=postgresql://stash:stash_local_only@127.0.0.1:55432/stash
# Production deletion intents must survive database restore and redeployment:
# DELETION_JOURNAL_DIR=/persistent/stash-deletions
